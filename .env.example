# ============================================================
# GentleBook frontend
#
# Local: copy to .env.local.
# Vercel: configure these values separately for Development,
# Staging/Preview and Production. Never commit real secrets.
# ============================================================

# Required. Must end in /api.
# Local example:       http://localhost:5000/api
# Staging example:     https://api-staging.gentlebook.app/api
# Production example: https://api.gentlebook.app/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Required for absolute links generated by the frontend.
# Local example:       http://localhost:3000
# Staging example:     https://staging.gentlebook.app
# Production example: https://app.gentlebook.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Platform name shown in the UI.
NEXT_PUBLIC_PLATFORM_NAME=GentleBook

# Optional analytics. Keep these unset in staging unless staging traffic
# should deliberately appear in a separate analytics property.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_ONETRUST_DOMAIN_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=app.gentlebook.app
